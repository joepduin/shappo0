@using shappo0.Models
@model List<shappo0.Models.Staff>

@{
    ViewData["Title"] = "Staff";

    <partial name="_SuccessMessage" />
}

<h1 class="mb-4">Staff</h1>

<a href="/Staff/AddStaff" class="btn btn-info">Create new staff member</a>

<h2>Active employees</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone number</th>
            <th>Role</th>
            <th>Is employed?</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var staff in Model)
        {
            if (staff.IsEmployed)
            {
                <tr>
                    <td>@staff.StaffId</td>
                    <td>@staff.Name</td>
                    <td>@staff.PhoneNumber</td>
                    <td>@staff.Role</td>
                    <td class="bg-success">@staff.IsEmployed</td>
                    <td><a href="/Staff/EditStaff/@staff.StaffId" class="btn btn-dark">Edit</a></td>
                </tr>
            }
        }
    </tbody>
</table>

<h2>Inactive employees</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Phone number</th>
            <th>Role</th>
            <th>Is employed?</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var staff in Model)
        {
            if (staff.IsEmployed == false)
            {
                <tr>
                    <td>@staff.StaffId</td>
                    <td>@staff.Name</td>
                    <td>@staff.PhoneNumber</td>
                    <td>@staff.Role</td>
                    <td class="bg-danger">@staff.IsEmployed</td>
                    <td><a href="/Staff/EditStaff/@staff.StaffId" class="btn btn-dark">Edit</a></td>
                </tr>
            }
        }
    </tbody>
</table>