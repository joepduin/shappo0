@model shappo0.ViewModels.TakeOrderViewModel

@{
    ViewData["Title"] = $"Order - Table {Model.TableNumber}";

    string? currentProductType = Context.Request.Query["productType"];
    string? currentMenuType = Context.Request.Query["menuType"];
}

<div class="container mt-4">

    <div class="card mb-5 border-primary">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Current Order: Table @Model.TableNumber</h3>
        </div>
        <div class="card-body p-0">
            @if (Model.OrderLines == null || Model.OrderLines.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    <h5>The cart is empty. Tap items below to add them!</h5>
                </div>
            }
            else
            {
                <table class="table table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Item</th>
                            <th class="text-center">Qty</th>
                            <th>Note</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderLines)
                        {
                            <tr>
                                <td class="align-middle fw-bold">@item.Product.Name</td>

                                <td class="align-middle text-center">
                                    <a href="/Order/DecreaseQuantity?productId=@item.Product.ProductId&tableNumber=@Model.TableNumber" class="btn btn-sm btn-outline-danger px-2">-</a>
                                    <span class="mx-2 fs-5">@item.Quantity</span>
                                    <a href="/Order/IncreaseQuantity?productId=@item.Product.ProductId&tableNumber=@Model.TableNumber" class="btn btn-sm btn-outline-success px-2">+</a>
                                </td>

                                <td class="align-middle">
                                    <form action="/Order/AddNote" method="post" class="d-flex">
                                        <input type="hidden" name="tableNumber" value="@Model.TableNumber" />
                                        <input type="hidden" name="productId" value="@item.Product.ProductId" />
                                        <input type="hidden" name="productType" value="@currentProductType" />
                                        <input type="hidden" name="menuType" value="@currentMenuType" />
                                        <input type="text" name="note" class="form-control form-control-sm me-2" placeholder="e.g. no salt" value="@item.Note" />
                                        <button type="submit" class="btn btn-sm btn-secondary">Save</button>
                                    </form>
                                </td>

                                <td class="align-middle text-end">
                                    <a href="/Order/RemoveLine?productId=@item.Product.ProductId&tableNumber=@Model.TableNumber" class="btn btn-sm btn-danger">X</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (Model.OrderLines != null && Model.OrderLines.Count > 0)
        {
            <div class="card-footer text-end bg-light">
                <a href="/Order/CancelOrder?tableNumber=@Model.TableNumber" class="btn btn-outline-danger me-2">Cancel Order</a>
                <a href="/Order/SaveOrder?tableNumber=@Model.TableNumber" class="btn btn-success btn-lg px-5">Send to Kitchen</a>
            </div>
        }
    </div>

    <div class="card mb-4 bg-light shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Filter Menu</h5>

            <div class="mb-3">
                <span class="fw-bold me-2">Menu:</span>
                <div class="btn-group" role="group">
                    <a href="/Order/TakeOrder?tableNumber=@Model.TableNumber&productType=@currentProductType"
                       class="btn btn-sm @(string.IsNullOrEmpty(currentMenuType) ? "btn-primary" : "btn-outline-primary")">All</a>
                    <a href="/Order/TakeOrder?tableNumber=@Model.TableNumber&menuType=Lunch&productType=@currentProductType"
                       class="btn btn-sm @(currentMenuType == "Lunch" ? "btn-primary" : "btn-outline-primary")">Lunch</a>
                    <a href="/Order/TakeOrder?tableNumber=@Model.TableNumber&menuType=Dinner&productType=@currentProductType"
                       class="btn btn-sm @(currentMenuType == "Dinner" ? "btn-primary" : "btn-outline-primary")">Dinner</a>
                </div>
            </div>

            <div>
                <span class="fw-bold me-2">Category:</span>
                <div class="btn-group flex-wrap" role="group">
                    <a href="/Order/TakeOrder?tableNumber=@Model.TableNumber&menuType=@currentMenuType"
                       class="btn btn-sm @(string.IsNullOrEmpty(currentProductType) ? "btn-primary" : "btn-outline-primary")">All</a>
                    <a href="/Order/TakeOrder?tableNumber=@Model.TableNumber&productType=Starter&menuType=@currentMenuType"
                       class="btn btn-sm @(currentProductType == "Starter" ? "btn-primary" : "btn-outline-primary")">Starters</a>
                    <a href="/Order/TakeOrder?tableNumber=@Model.TableNumber&productType=Main&menuType=@currentMenuType"
                       class="btn btn-sm @(currentProductType == "Main" ? "btn-primary" : "btn-outline-primary")">Mains</a>
                    <a href="/Order/TakeOrder?tableNumber=@Model.TableNumber&productType=Dessert&menuType=@currentMenuType"
                       class="btn btn-sm @(currentProductType == "Dessert" ? "btn-primary" : "btn-outline-primary")">Desserts</a>
                    <a href="/Order/TakeOrder?tableNumber=@Model.TableNumber&productType=Drink&menuType=@currentMenuType"
                       class="btn btn-sm @(currentProductType == "Drink" ? "btn-primary" : "btn-outline-primary")">Drinks</a>
                </div>
            </div>
        </div>
    </div>

    <div>
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model.AllProducts)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm text-center">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-secondary mb-2">@product.ProductType</span>
                                <h5 class="card-title">@product.Name</h5>
                            </div>
                            <div>
                                <p class="card-text text-success fw-bold fs-5 mb-1">€@product.PriceIncludingTax.ToString("0.00")</p>

                                @if (product.Stock == 0)
                                {
                                    <small class="text-danger fw-bold d-block mb-2">Stock: 0</small>
                                }
                                else if (product.Stock < 10)
                                {
                                    <small class="text-warning fw-bold d-block mb-2">
                                        ⚠️ Only @product.Stock left!
                                    </small>
                                }
                                else
                                {
                                    <small class="text-muted d-block mb-2">Stock: @product.Stock</small>
                                }

                                @if (product.Stock > 0)
                                {
                                    <a href="/Order/AddToOrder?productId=@product.ProductId&tableNumber=@Model.TableNumber&productType=@currentProductType&menuType=@currentMenuType"
                                       class="btn btn-primary w-100 mt-2">Add to Order</a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100 mt-2" disabled>Out of Stock</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>