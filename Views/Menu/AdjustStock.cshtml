@using shappo0.Models
@model List<shappo0.Models.Product>

<!-- This page is used for adjusting stock in bulk -->
@{
	ViewData["Title"] = "Adjust Stock";

	<partial name="_ErrorMessage" />
}

<h1>Adjust Product Stock</h1>

<div class="mb-3">
	<a href="/Menu/Index" class="btn btn-secondary">Return to Menu</a>
</div>

@if (Model.Any(p => p.Stock < 10 && p.OnMenu))
{
	<div class="alert alert-danger" role="alert">
		<h3>⚠️ Low Stock Warning</h3>
		<p>The following items have less than 10 units remaining:</p>

		<table class="table table-bordered bg-white">
			<thead>
				<tr>
					<th>Product ID</th>
					<th>Name</th>
					<th>Stock</th>
				</tr>
			</thead>
			<tbody>
				@foreach (Product product in Model)
				{
					if (product.Stock < 10 && product.OnMenu)
					{
						<tr>
							<td>@product.ProductId</td>
							<td>@product.Name</td>
							<td><strong>@product.Stock</strong></td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

<form action="/Menu/AdjustStock" method="POST">
	<table class="table align-middle">
		<thead>
			<tr>
				<th>Product ID</th>
				<th>Name</th>
				<th>Current stock</th>
				<th style="width: 150px;">New Stock Level</th>
			</tr>
		</thead>

		<tbody>
			<!-- A 'foreach' loop doesn't work in this scenario -->
			@for (int i = 0; i < Model.Count; i++)
			{
				<tr>
					<td>
						@Model[i].ProductId
						<!-- Uses a hidden field to add the ProductId along when making a POST request -->
						<input type="hidden" name="[@i].ProductId" value="@Model[i].ProductId" />
					</td>
					<td>@Model[i].Name</td>
					<td>@Model[i].Stock</td>
					<td>
						<input type="number" name="[@i].Stock" class="form-control" value="@Model[i].Stock" min="0" required />
					</td>
				</tr>
			}
		</tbody>
	</table>

	<!-- Submits a list with all products and their adjusted stock -->
	<div class="mt-4 mb-5">
		<button type="submit" class="btn btn-primary btn-lg">Save All Changes</button>
	</div>
</form>
