@using shappo0.ViewModels
@model ProductsViewModel

@{
	ViewData["Title"] = "Products";

	FilterItems? activeFilters = ViewData["ActiveFilter"] as FilterItems;

	// Displays a banner with a confirm message if redirected to this page from either add or edit
	<partial name="_SuccessMessage" />
}

<h1 class="mb-4">Products</h1>

<!-- Only displays the CRU(D) actions if the logged in user is a Manager
Uses 'IsInRole()', which is a default Method from ASP.NET using the RolePrincipal
-->
@if (User.IsInRole("Manager"))
{
	<div class="d-flex justify-content-between align-items-center mb-3">
		<div class="d-flex gap-2">
			<a href="/Menu/AddDrink" class="btn btn-info">Add new drink</a>
			<a href="/Menu/AddFoodItem" class="btn btn-info">Add new food item</a>
		</div>
		<div>
			<a href="/Menu/AdjustStock" class="btn btn-secondary">Adjust Stock</a>
		</div>
	</div>
}

<!-- Filters -->
<form method="GET" action="/Menu/Index" class="row g-3 mb-4 p-3 bg-light border rounded">
	<h5>Filter Menu Items</h5>

	<div class="col-md-3">
		<label class="form-label">Product Type</label>
		<select name="productType" class="form-select">
			<option value="">All Types</option>
			<option value="Drink" selected="@(activeFilters?.ProductType == "Drink" ? "selected" : null)">Drink</option>
			<option value="Starter" selected="@(activeFilters?.ProductType == "Starter" ? "selected" : null)">Starter</option>
			<option value="Intermediary" selected="@(activeFilters?.ProductType == "Intermediary" ? "selected" : null)">Intermediary</option>
			<option value="Main" selected="@(activeFilters?.ProductType == "Main" ? "selected" : null)">Main Course</option>
			<option value="Dessert" selected="@(activeFilters?.ProductType == "Dessert" ? "selected" : null)">Dessert</option>
		</select>
	</div>

	<div class="col-md-3">
		<label class="form-label">Menu Type</label>
		<select name="menuType" class="form-select">
			<option value="">All Menus</option>
			<option value="Lunch" selected="@(activeFilters?.MenuType == "Lunch" ? "selected" : null)">Lunch</option>
			<option value="Dinner" selected="@(activeFilters?.MenuType == "Dinner" ? "selected" : null)">Dinner</option>
		</select>
	</div>

	<div class="col-md-3">
		<label class="form-label">On menu?</label>
		<select name="onMenu" class="form-select">
			<option value=null>Any status</option>
			<option value="true" selected="@(activeFilters?.OnMenu == true ? "selected" : null)">On menu</option>
			<option value="false" selected="@(activeFilters?.OnMenu == false ? "selected" : null)">Off menu</option>
		</select>
	</div>

	@* Submit and Reset *@
	<div class="col-md-3 d-flex align-items-end gap-2">
		<button type="submit" class="btn btn-primary w-100">Filter</button>
		<a href="/Menu/Index" class="btn btn-outline-secondary w-100">Clear</a>
	</div>
</form>

<!-- Low Stock alert -->
@if (Model.LowStockProducts.Any(p => p.OnMenu))
{
	<div class="alert alert-danger" role="alert">
		<h3>⚠️ Low Stock Warning</h3>
		<p>The following items have less than 10 units remaining:</p>

		<table class="table table-bordered bg-white">
			<thead>
				<tr>
					<th>Product ID</th>
					<th>Name</th>
					<th>Stock</th>
					@if (User.IsInRole("Manager"))
					{
						<th>Action</th>
					}
				</tr>
			</thead>
			<tbody>
				@foreach (Product product in Model.LowStockProducts)
				{
					if (product.OnMenu)
					{
						<tr>
							<td>@product.ProductId</td>
							<td>@product.Name</td>
							<td><strong>@product.Stock</strong></td>
							@if (User.IsInRole("Manager"))
							{
								<td>
									<a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-danger">Edit</a>
								</td>
							}

						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

<!-- Products table -->
<table class="table">
	<thead>
		<tr>
			<th>Product ID</th>
			<th>Name</th>
			<th>Price</th>
			<th>Stock</th>
			<th>Product type</th>
			<th>Time of day</th>
			<th>On menu?</th>
			@if (User.IsInRole("Manager"))
			{
				<th>Actions</th>
			}
		</tr>
	</thead>

	<tbody>
		@{
			foreach (Product product in Model.AllProducts)
			{
				<tr>
					<td>@product.ProductId</td>
					<td>@product.Name</td>
					<td>€@Math.Round(product.PriceIncludingTax, 2)</td>
					<td>@product.Stock</td>
					<td>@product.ProductType</td>
					<td>@product.MenuType</td>
					<td class="@(product.OnMenu ? "bg-success" : "bg-danger")">@(product.OnMenu ? "True" : "False")</td>
					@if (User.IsInRole("Manager"))
					{
						<td>
							<a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-outline-dark">Edit</a>
						</td>
					}
				</tr>
			}
		}
	</tbody>
</table>
