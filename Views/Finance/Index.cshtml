@using shappo0.ViewModels
@model FinanceViewModel

@{
	ViewData["Title"] = "Financial Overview";
}

<div class="container mt-4">
	<h2>Financial Overview</h2>
	<hr />

	<!-- The date filter buttons/selectors -->

	<div class="card p-3 mb-4 bg-light">
		<form action="/Finance/Index" method="POST" class="row g-3 align-items-end">

			<div class="col-12 mb-2">
				<label class="form-label d-block">Quick Filters</label>
				<div class="btn-group w-100" role="group">
					<button type="submit" name="quickFilter" value="month" class="btn btn-outline-secondary">This Month</button>
					<button type="submit" name="quickFilter" value="quarter" class="btn btn-outline-secondary">This Quarter</button>
					<button type="submit" name="quickFilter" value="year" class="btn btn-outline-secondary">This Year</button>
				</div>
			</div>

			<div class="col-md-4">
				<label for="range.Start" class="form-label">Start Date</label>
				<input type="date" id="range.Start" name="range.Start" class="form-control" value="@Model.StartDate" />
			</div>
			<div class="col-md-4">
				<label for="range.End" class="form-label">End Date</label>
				<input type="date" id="range.End" name="range.End" class="form-control" value="@Model.EndDate" />
			</div>
			<div class="col-md-4">
				<button type="submit" name="quickFilter" value="custom" class="btn btn-primary w-100">Filter Custom Dates</button>
			</div>
		</form>
	</div>

	<!-- The actual finance + tips data -->

	<div class="row">
		<div class="col-md-8">
			<h4>Finances per category</h4>
			<!-- This is used to check if any data is provided -->
			@if (Model == null || !Model.IncomeData.Any())
			{
				<div class="alert alert-warning">No transaction data found.</div>
			}
			else
			{
				<table class="table table-striped table-bordered">
					<thead class="table-dark">
						<tr>
							<th>Menu Category</th>
							<th class="text-end">Total Items Ordered</th>
							<th class="text-end">Total Revenue (incl. VAT)</th>
						</tr>
					</thead>
					<tbody>
						@foreach (Finance item in Model.IncomeData)
						{
							<!-- 
								Since MenuType is used, the type 'Drinks' doesn't exist and will fall under the 'All' category 
								Instead of naming giving the MenuType value in this row the 'All' value, I just make a custom exception for Drinks
							-->
							if (item.MenuType == "All")
							{
								<tr>
									<td class="text-capitalize">Drinks</td>
									<td class="text-end">@item.TotalItemsOrdered</td>
									<td class="text-end">€@item.TotalRevenue.ToString("F2")</td>
								</tr>
							}
							else
							{
								<tr>
									<td class="text-capitalize">@item.MenuType</td>
									<td class="text-end">@item.TotalItemsOrdered</td>
									<td class="text-end">€@item.TotalRevenue.ToString("F2")</td>
								</tr>
							}
						}
					</tbody>
				</table>
			}
		</div>

		<div class="col-md-4">
			<h4>Tips Earnings</h4>
			<div class="card text-white bg-success mb-3">
				<div class="card-header font-weight-bold">Total Tips</div>
				<div class="card-body">
					<h3 class="card-title">€@(Model?.TotalTips.ToString("F2"))</h3>
					<p class="card-text">Total tips collected from visits within this date range.</p>
				</div>
			</div>
		</div>
	</div>
</div>