@model IEnumerable<shappo0.Models.Table>
@using System.Linq
@{
    ViewData["Title"] = "Tables";
}

<style>
    .tables-grid {
        display: grid;
        grid-template-columns: repeat(2, 120px);
    }

    .table-square {
        padding: 12px;
        margin: 12px;
    }
</style>

<h2>Tables</h2>

<div class="tables-grid">
    @foreach (Table table in Model)
    {
        string bg;
        if (table.Status == TableStatusType.Occupied)
        {
            bg = "#d9534f"; //rood
        }
        else
        {
           bg = "#5cb85c"; //groen
        }
        
        <div class="table-square" style="background-color:@bg">
            Table @table.TableNumber
        </div>
    }
</div>
