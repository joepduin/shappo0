@using System.Linq
@using shappo0.Enums
@using shappo0.ViewModels
@using shappo0.Extensions
@model IEnumerable<TableViewModel>
@{
    ViewData["Title"] = "Tables";
}

<style>
    .tables-grid {
        display: grid;
        grid-template-columns: repeat(2, 120px);
    }

    .table-square {
        padding: 12px;
        margin: 12px;
    }
</style>

<h2>Tables</h2>

<div class="tables-grid">
    @foreach (TableViewModel table in Model)
    {
        string bg;
        if (table.Status)
        {
            bg = "#d9534f"; //rood
        }
        else
        {
           bg = "#5cb85c"; //groen
        }

        <a href="Table/Table?tableNumber=@table.TableNumber">
            <div class="table-square" style="background-color:@bg">
                Table @table.TableNumber
                <div>
                    Food: @table.FoodStatus.ToEmoji()
                    <br />
                    Drink: @table.DrinkStatus.ToEmoji()
                </div>
            </div>
        </a>
    }
</div>
