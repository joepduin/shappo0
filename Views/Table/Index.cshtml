@using System.Linq
@using shappo0.Enums
@using shappo0.ViewModels
@using shappo0.Extensions
@model IEnumerable<TableViewModel>
@{
    ViewData["Title"] = "Tables";
    <partial name="_SuccessMessage" />
}

<style>
    .tables-grid {
        display: grid;
        grid-template-columns: repeat(2, 120px);
    }

    .table-square {
        padding: 12px;
        margin: 12px;
    }
</style>

<h2>Tables</h2>

<div class="tables-grid">
    @foreach (TableViewModel tableViewModel in Model)
    {
        string bg;
        if (tableViewModel.Table.Status)
        {
            bg = "#d9534f"; //rood
        }
        else
        {
           bg = "#5cb85c"; //groen
        }

        <a href="Table/Table?tableNumber=@tableViewModel.Table.TableNumber" style="text-decoration: none;">
            <div class="table-square text-dark" style="background-color:@bg;">
                Table @tableViewModel.Table.TableNumber
                <div>
                    Food: @tableViewModel.FoodStatus.ToEmoji()
                    <br />
                    Drink: @tableViewModel.DrinkStatus.ToEmoji()
                </div>
            </div>
        </a>
    }
</div>
