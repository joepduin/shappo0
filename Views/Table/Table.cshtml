@using shappo0.ViewModels
@using shappo0.Models
@model List<shappo0.ViewModels.TableViewModel>
@{
    ViewData["Title"] = "Table Status";
}

<h2>Table @(ViewBag.TableNumber)</h2>

@{
    if (ViewBag.Message != null)
    {
        <div class="alert alert-danger">@ViewBag.Message</div>
    }
}

@if (Model != null)
{
    @foreach (TableViewModel order in Model)
    {
        <h3>Order: @order.OrderNumber, @order.Status</h3>

        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Aantal</th>
                    <th>Opmerking</th>
                    <th>Item status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (OrderLine orderLine in order.OrderLines)
                {
                    <tr>
                        <td>@orderLine.Product.Name</td>
                        <td>@orderLine.Quantity</td>
                        <td>@orderLine.Note</td>
                        <td>@orderLine.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}