@model List<Order>
@using shappo0.Enums;
@using shappo0.ViewModels
@{
	ViewData["Title"] = "Bar";
}
<h1>Bar</h1>
<h2>Running orders</h2>

<!-- button to see the finished orders page -->
<a asp-action="FinishedOrders" class="btn btn-primary">
	View Finished orders
</a>

<table class="table">
	<thead>
		<tr>
			<th>Order number</th>
			<th>Table number</th>
			<th>staff name</th>
			<th>Status</th>
			<th>Time created</th>
			<th>Waiting time</th>
			<th>Order details</th>
			<th>Change Status</th>
		</tr>
	</thead>
	<tbody>
		@{
			foreach (Order order in Model)
			{
				var rowStyle = "";

				<tr @rowStyle>
					<td>@order.OrderNumber</td>
					<td>@order.Visit.Table.TableNumber</td>
					<td>@order.Staff.Name</td>
					<td>@order.Status</td>
					<td>@order.TimeCreated</td>
					<td>@order.WaitingTimeMinutes</td>
					<td>
						<!-- button to see the orderlines-->
						<a asp-controller="Bar"
						   asp-action="ViewOrder"
						   asp-route-id="" class="btn btn-outline-dark"
						   asp-route-orderNumber="@order.OrderNumber">
							View Order
						</a>


					</td>
					<td>
						<!-- dropwdown to change the order status to finished-->
						<form asp-action="UpdateOrderStatus" method="post">
							<input type="hidden" name="orderNumber" value="@order.OrderNumber" />

							<select name="status" onchange="this.form.submit()">
								<option value="Ordered"
										selected="@(order.Status == OrderStatus.Ordered)">
									Ordered
								</option>
								<option value="BeingPrepared"
										selected="@(order.Status == OrderStatus.BeingPrepared)">
									BeingPrepared
								</option>
								<option value="ReadyToBeServed"
										selected="@(order.Status == OrderStatus.ReadyToBeServed)">
									ReadyToBeServed
								</option>
							</select>
						</form>
					</td>
				</tr>
			}
		}
	</tbody>
</table>