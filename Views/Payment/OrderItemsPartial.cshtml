@model IEnumerable<shappo0.Models.OrderItem>

<table class="table">
    <thead>
        <tr>
            <th>Aantal</th>
            <th>Item</th>
            <th>Prijs per stuk</th>
            <th>Totaal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Count x</td>
                <td>@item.MenuItem.Name</td>
                <td>€ @item.MenuItem.Price.ToString("0.00")</td>
                <td>€ @((item.MenuItem.Price * item.Count).ToString("0.00"))</td>
            </tr>
        }
    </tbody>
</table>