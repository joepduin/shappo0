@model shappo0.Models.Bill

@{
    ViewData["Title"] = "Checkout";
}

<h2>Checkout Table @Model.Visit.Table.TableNumber</h2>

@if (Model == null || Model.OrderLines.Count == 0)
{
    <div class="alert alert-info">No orders were found for this table.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Quantity</th>
                <th>Product</th>
                <th>Price per piece</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.OrderLines)
            {
                <tr>
                    <td>@line.Quantity x</td>
                    <td>@line.Product.Name</td>
                    <td>&euro; @line.Product.PriceIncludingTax.ToString("0.00")</td>
                    <td>&euro; @((line.Product.PriceIncludingTax * line.Quantity).ToString("0.00"))</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mb-4">
        <p><strong>Subtotal:</strong> &euro; @Model.SubTotal.ToString("0.00")</p>
        <p><strong>VAT Low (9%):</strong> &euro; @Model.VatLow.ToString("0.00")</p>
        <p><strong>VAT High (21%):</strong> &euro; @Model.VatHigh.ToString("0.00")</p>
        <h3><strong>Total:</strong> &euro; @Model.Total.ToString("0.00")</h3>
    </div>

    <hr />

    <form asp-action="CreateBill" method="post">
        <input type="hidden" name="Visit.VisitId" value="@Model.Visit.VisitId" />
        <input type="hidden" name="Visit.Table.TableNumber" value="@Model.Visit.Table.TableNumber" />
        <input type="hidden" name="SubTotal" value="@Model.SubTotal" />
        <input type="hidden" name="Total" value="@(Model.Total)" />
        <input type="hidden" name="VatLow" value="@Model.VatLow" />
        <input type="hidden" name="VatHigh" value="@Model.VatHigh" />

        <div class="form-group mb-4">
            <label for="SplitChoice">Split choice</label>
            <select name="SplitChoice" id="SplitChoice" class="form-control" required onchange="togglePeople()">
                <option value="Single">Single (Pay total)</option>
                <option value="Equal">Equal split</option>
                <option value="Custom">Custom split</option>
            </select>
        </div>

        <div class="form-group mb-4" id="NumberOfPeople" style="display: none;">
            <label for="NumberOfPeople">Number of people</label>
            <input type="number" name="NumberOfPeople" id="NumberOfPeople" class="form-control" value="2" min="2" />
        </div>

        <button type="submit" class="btn btn-success">Create Bill & Proceed to Payment</button>
    </form>

    <script>
        function togglePeople() 
        {
            var SplitChoice = document.getElementById("SplitChoice");
            var NumberOfPeople = document.getElementById("NumberOfPeople");

            if (SplitChoice.value == "Equal") 
            {
                NumberOfPeople.style.display = "block";
            } 
            else 
            {
                NumberOfPeople.style.display = "none";
            }
        }
    </script>
}