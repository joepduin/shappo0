@model shappo0.ViewModels.PaymentViewModel

<h2>Afrekenen Tafel @Model.TableId</h2>

@if (Model.Items == null || Model.Items.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        Er is geen openstaande bestelling gevonden voor deze tafel. Zorg dat er producten zijn toegevoegd aan deze tafel.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Aantal</th>
                <th>Item</th>
                <th>Prijs per stuk</th>
                <th>Totaal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Quantity x</td>
                    <td>@item.Product.Name</td>
                    <td>€ @(item.Product.Price.ToString("0.00"))</td>
                    <td>€ @((item.Product.Price * item.Quantity).ToString("0.00"))</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />
    <div>
        <p>BTW 9% (Eten/Fris): € @Model.VatLow.ToString("0.00")</p>
        <p>BTW 21% (Alcohol): € @Model.VatHigh.ToString("0.00")</p>
        <h3>Te betalen: € @Model.TotalAmount.ToString("0.00")</h3>
    </div>
}