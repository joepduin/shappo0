@model shappo0.ViewModels.PaymentSubmissionViewModel
@using shappo0.Enums
@{
    var overview = ViewBag.PaymentOverview as shappo0.ViewModels.PaymentViewModel;
}

<h2>Afrekenen Tafel @Model.TableNumber</h2>

<partial name="_ErrorMessage" />

@if (overview == null || overview.Items == null || overview.Items.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        No open orders found for this table. Please ensure products have been added.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Aantal</th>
                <th>Item</th>
                <th>Prijs per stuk</th>
                <th>Totaal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in overview.Items)
            {
                <tr>
                    <td>@item.Quantity x</td>
                    <td>@item.Product.Name</td>
                    <td>€ @(item.Product.Price.ToString("0.00"))</td>
                    <td>€ @((item.Product.Price * item.Quantity).ToString("0.00"))</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />
    <div>
        <p>BTW 9% (Eten/Fris): € @overview.VatLow.ToString("0.00")</p>
        <p>BTW 21% (Eten/Alcohol): € @overview.VatHigh.ToString("0.00")</p>
        <h3>Te betalen totaal: € @overview.TotalAmount.ToString("0.00")</h3>
        <h4>Resterend bedrag: € @overview.RemainingAmount.ToString("0.00")</h4>
    </div>

    <hr />

    <form method="post" asp-action="ProcessPayment">
        <input type="hidden" name="TableNumber" value="@Model.TableNumber" />
        <input type="hidden" name="VisitId" value="@Model.VisitId" />

        <div class="mb-3">
            <label class="form-label">Split type</label>
            <div>
                <input type="radio" id="equal" name="IsEqualSplit" value="true" checked /> <label for="equal">Gelijk verdelen</label>
                <input type="radio" id="different" name="IsEqualSplit" value="false" /> <label for="different">Verschillende bedragen</label>
            </div>
        </div>

        <div class="mb-3">
            <label for="SplitCount" class="form-label">Aantal personen</label>
            <input type="number" id="SplitCount" name="SplitCount" class="form-control" value="1" min="1" />
        </div>

        <div class="mb-3">
            <label for="PaymentAmount" class="form-label">Bedrag van deze betaling (€)</label>
            <input type="number" step="0.01" id="PaymentAmount" name="PaymentAmount" class="form-control" value="0" />
        </div>

        <div class="mb-3">
            <label for="TipAmount" class="form-label">Fooi (extra) (€)</label>
            <input type="number" step="0.01" id="TipAmount" name="TipAmount" class="form-control" value="0" />
        </div>

        <div class="mb-3">
            <label class="form-label">Betaalmethode</label>
            <div>
                <input type="radio" id="credit" name="PaymentMethod" value="@PaymentMethodType.CreditCard" checked /> <label for="credit">Credit card</label>
                <input type="radio" id="debit" name="PaymentMethod" value="@PaymentMethodType.DebitCard" /> <label for="debit">Debit card</label>
                <input type="radio" id="cash" name="PaymentMethod" value="@PaymentMethodType.Cash" /> <label for="cash">Cash</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Feedback type</label>
            <select name="FeedbackType" class="form-select">
                <option value="@FeedbackCategory.Compliment">Compliment</option>
                <option value="@FeedbackCategory.Klacht">Complaint</option>
                <option value="@FeedbackCategory.Opmerking">Comment</option>
            </select>
        </div>

        <div class="mb-3">
            <label for="FeedbackDescription" class="form-label">Feedback</label>
            <textarea id="FeedbackDescription" name="FeedbackDescription" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Pay the Bill</button>
    </form>
}