@using shappo0.Models
@model List<shappo0.Models.Kitchen>
@{
	ViewData["Title"] = "Finished Orders";
}
<h1>Kitchen</h1>
<h2>Finished orders</h2>
<!-- button to see the running orders page (index)-->
<a asp-action="Index" class="btn btn-primary">
	View Running orders
</a>
<table class="table">
	<thead>
		<tr>
			<th>Order number</th>
			<th>Table number</th>
			<th>Status</th>
			<th>Time created</th>
			<th>Waiting time</th>
			<th>Order details</th>

		</tr>
	</thead>
	<tbody>
		@{
			foreach (Kitchen kitchen in Model)
			{
				var rowStyle = "";

				<tr @rowStyle>
					<td>@kitchen.OrderNumber</td>
					<td>@kitchen.TableNumber</td>
					<td>@kitchen.Status</td>
					<td>@kitchen.TimeCreated</td>
					<td>@kitchen.WaitingTime</td>
					<td>
					<!-- button to see the oderlines-->
						<a asp-controller="Kitchen"
						   asp-action="ViewOrder"
						   asp-route-id="" class="btn btn-outline-dark"
						   asp-route-orderNumber="@kitchen.OrderNumber">
							View Order
						</a>


					</td>
					
				</tr>
			}
		}
	</tbody>
</table>
