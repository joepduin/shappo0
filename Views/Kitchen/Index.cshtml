@model shappo0.ViewModels.KitchenBarViewModel
@using shappo0.Enums;
@{
	ViewData["Title"] = "Kitchen";
}
<h1>Kitchen</h1>
<h2>Running orders</h2>
<!-- button to see the finished orders page (index)-->
<a asp-action="FinishedOrders" class="btn btn-primary">
	View Finished orders
</a>
<table class="table">
	<thead>
		<tr>
			<th>Order number</th>
			<th>Table number</th>
			<th>Status</th>
			<th>Time created</th>
			<th>Waiting time</th>
			<th>Order details</th>
			<th>Change Status</th>
		</tr>
	</thead>
	<tbody>
		@{
			foreach (Kitchen kitchen in Model.Kitchen)
			{
				var rowStyle = "";
			
				<tr @rowStyle>
				<td>@kitchen.OrderNumber</td>
				<td>@kitchen.TableNumber</td>
				<td>@kitchen.Status</td>
				<td>@kitchen.TimeCreated</td>
				<td>@kitchen.WaitingTime</td>
					<td>
						<!-- button to see the orderlines-->
						<a asp-controller="Kitchen"
						   asp-action="ViewOrder"
						   asp-route-id="" class="btn btn-outline-dark"
						   asp-route-orderNumber="@kitchen.OrderNumber">
							View Order
						</a>

						
					</td>
					<td>
						<!-- dropdown to change the whole order status to finished-->
					<form asp-action="UpdateOrderStatus" method="post">
					<input type="hidden" name="orderNumber" value="@kitchen.OrderNumber" />

					<select name="status" onchange="this.form.submit()">
								<option value="Ordered"
										selected="@(kitchen.Status == OrderStatus.Ordered)">
									Ordered
								</option>
								<option value="BeingPrepared"
										selected="@(kitchen.Status == OrderStatus.BeingPrepared)">
									Being Prepared
								</option>
								<option value="ReadyToBeServed"
										selected="@(kitchen.Status == OrderStatus.ReadyToBeServed)">
									Ready to be Served
								</option>
					</select>
					</form>
					</td>
				</tr>
			}
		}
	</tbody>
</table>

